{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "next-up-api",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:4173,http://127.0.0.1:4173,http://terminal.local:4173",
    "STORE_ENABLED": "false",
    "UPSTREAM_PER_MINUTE": "16",
    "UPSTREAM_PER_DAY": "300",
    "PRIVACY_CONTACT": "",
    "CONTROLLER_NAME": "",
    "DATA_COUNTRIES": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "next-up",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": false },
}
